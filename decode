#Uesugi_Cipher_Decoder(上杉暗号解読コード)
uesugi_cipher = [["い","ろ","は","に","ほ","へ","と"],
                 ["ち","り","ぬ","る","を","わ","か"],
                 ["よ","た","れ","そ","つ","ね","な"],
                 ["ら","む","う","ゐ","の","お","く"],
                 ["や","ま","け","ふ","こ","え","て"],
                 ["あ","さ","き","ゆ","め","み","し"],
                 ["ゑ","ひ","も","せ","す","ん","ー"],
                 ["が","ぎ","ぐ","げ","ご","ざ","じ"],
                 ["ず","ぜ","ぞ","だ","ぢ","づ","で"],
                 ["ど","ば","び","ぶ","べ","ぼ","ぱ"],
                 ["ぴ","ぷ","ぺ","ぽ","ゃ","ゅ","ょ"],
                 ["っ"]]
import sys
for num in sys.stdin:
    message = num.strip()
times = len(message)
for i in range(times):
    if(i%2 == 0):
        first = int(message[i],16)
        last = int(message[i+1],16)
        print(f"{uesugi_cipher[first-1][last-1]}",end="")
print("")